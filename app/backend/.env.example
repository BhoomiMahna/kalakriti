# ─── Artisan Platform Backend — Environment ─────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
OTP_DEV_MODE=true          # true = OTP returned in API response for local testing

# ── AI pipeline (optional; heavy) ───────────────────────────────────────────
# Leave false to use the built-in graceful-fallback pipeline (no GPU needed).
ENABLE_AI_PIPELINE=false
GOOGLE_API_KEY=            # Gemini key, only if ENABLE_AI_PIPELINE=true

# ── AI Product Photoshoot (generative images) ───────────────────────────────
# Provider: ""/"demo" (compositor, no GPU), "flux_url", "gemini", or "openai".
IMAGE_PROVIDER=
IMAGE_ENHANCER_URL=          # FLUX service endpoint when IMAGE_PROVIDER=flux_url
OPENAI_API_KEY=              # when IMAGE_PROVIDER=openai

# ── Demo mode ────────────────────────────────────────────────────────────────
# true = simulate marketplace publishing + serve internal demo listing pages.
DEMO_MODE=true

# ── Instagram automation (artisans_ai.instagram) ────────────────────────────
INSTAGRAM_ENABLED=true
INSTAGRAM_DEMO_MODE=true            # simulate posting (no Meta creds needed)
INSTAGRAM_ACCOUNT_HANDLE=@kalakriti.craft
INSTAGRAM_POST_THRESHOLD=0.55
GEMINI_API_KEY=                     # caption LLM; falls back to GOOGLE_API_KEY, then offline
# Real mode (INSTAGRAM_DEMO_MODE=false) needs a public API_BASE_URL + these:
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ── Amazon SP-API ───────────────────────────────────────────────────────────
AMAZON_ENABLED=false
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SELLER_ID=
AMAZON_REGION=eu
AMAZON_SANDBOX=true

# ── ONDC ────────────────────────────────────────────────────────────────────
ONDC_ENABLED=false
ONDC_BASE_URL=https://staging.registry.ondc.org
ONDC_SUBSCRIBER_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_UNIQUE_KEY_ID=
