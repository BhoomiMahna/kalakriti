# ─── Artisan AI — Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM (required) ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=
# OPENAI_API_KEY=

# ── ASR Provider ─────────────────────────────────────────────────────────────
# Options: whisper, bhashini, sarvam
ASR_PROVIDER=whisper

# ── Whisper (only when ASR_PROVIDER=whisper) ─────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=small

# ── BHASHINI (only when ASR_PROVIDER=bhashini) ───────────────────────────────
# Register at https://bhashini.gov.in to obtain credentials
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96dadc500b55c543cd
SARVAM_API_KEY=your_actual_key_here
# ── Sarvam AI (only when ASR_PROVIDER=sarvam) ────────────
# Get your key at https://console.sarvam.ai
SARVAM_API_KEY=

# ── Translation ──────────────────────────────────────────────────────────────
# Options: indictrans2, opus_mt
TRANSLATION_PROVIDER=indictrans2

# ── Device ───────────────────────────────────────────────────────────────────
# Options: auto, cpu, cuda, mps
DEVICE=auto
